# Read by the live suites (./mvnw verify -Plive). Real environment variables take precedence.
CELERIS_WS_URL=
CELERIS_CLIENT_ID=
CELERIS_SIGNING_SECRET=
# Optional: a gateway that routes to a different server node. The cross-node tests open their
# second connection through it, and skip when it is unset.
# CELERIS_WS_URL_PEER=
